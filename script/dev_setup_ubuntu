#!/usr/bin/bash
#
# Run on a fresh Ubuntu box (as root) or an already-provisioned one
# (as mo) -- detects which and does the right thing either way.
#
# As root: runs the one-time system prep (create the mo user, /var/web,
# apt packages, chruby, ruby-install -- see script/dev_setup/ubuntu_root.sh),
# then hands off to mo to finish. Interactive: may prompt for a `mo`
# password if one isn't set yet (needed for `mo` to sudo later) --
# works fine run from a local/downloaded file; if piped straight
# through `curl | bash`, that one prompt may not work cleanly, since
# it'd be reading from the same stdin bash is still consuming as
# script source. Re-run it as mo directly (see below) if that happens.
#
# As mo: clones the repo if needed, sets up Ruby/gems/the database,
# and runs the test suite.
#
# Usage (fresh box, as root):
#   curl -s https://raw.githubusercontent.com/MushroomObserver/mushroom-observer/HEAD/script/dev_setup_ubuntu | bash
# Usage (already-provisioned box, as mo):
#   curl -s https://raw.githubusercontent.com/MushroomObserver/mushroom-observer/HEAD/script/dev_setup_ubuntu | bash

if [ "$(id -u)" -eq 0 ]; then
    if [ -f script/dev_setup/ubuntu_root.sh ]; then
        source script/dev_setup/ubuntu_root.sh
    else
        source <(curl -s "https://raw.githubusercontent.com/MushroomObserver/mushroom-observer/HEAD/script/dev_setup/ubuntu_root.sh")
    fi
    mo_ubuntu_root_setup

    echo "Continuing as mo..."
    exec su - mo -c "curl -s https://raw.githubusercontent.com/MushroomObserver/mushroom-observer/HEAD/script/dev_setup_ubuntu | bash"
fi

cd /var/web || exit 1

if [ -f script/dev_setup/clone_repo.sh ]; then
    source script/dev_setup/clone_repo.sh
else
    source <(curl -s "https://raw.githubusercontent.com/MushroomObserver/mushroom-observer/HEAD/script/dev_setup/clone_repo.sh")
fi
mo_ensure_repo

# shellcheck source=script/dev_setup/common.sh
source script/dev_setup/common.sh
# shellcheck source=script/dev_setup/finish_app_setup.sh
source script/dev_setup/finish_app_setup.sh

ruby-install ruby "$(cat .ruby-version)"

# Requires access to ruby
source /usr/local/share/chruby/chruby.sh
source /usr/local/share/chruby/auto.sh

EXPECTED_RUBY=$(cat .ruby-version)
ACTUAL_RUBY=$(ruby --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')

if [ "$ACTUAL_RUBY" != "$EXPECTED_RUBY" ]; then
    echo "ERROR: Ruby version mismatch"
    echo "Required: $EXPECTED_RUBY"
    echo "Installed: $ACTUAL_RUBY"
    echo "Please install the correct Ruby version using ruby-install"
    exit 1
fi

echo "Ruby version check passed: $ACTUAL_RUBY"

mo_finish_app_setup "ubuntu"

# Rock and Roll!
bin/rails test
