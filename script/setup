#!/usr/bin/env bash
#
# Thin OS-detecting dispatcher for dev_setup_macos / dev_setup_ubuntu --
# lets onboarding docs and curl-pipe instructions name one script
# instead of picking between two. Detects the platform via `uname -s`
# and hands off entirely; all the setup logic stays in the
# platform-specific script.
#
# Usage (fresh machine, nothing cloned yet):
#   curl -s https://raw.githubusercontent.com/MushroomObserver/mushroom-observer/HEAD/script/setup | bash
# Usage (from an existing checkout):
#   script/setup
# Usage (just (re)sync the private icon-library repo, skip everything else):
#   script/setup --icons-only

if [ -f script/dev_setup/clone_repo.sh ]; then
    source script/dev_setup/clone_repo.sh
else
    source <(curl -fsSL "https://raw.githubusercontent.com/MushroomObserver/mushroom-observer/HEAD/script/dev_setup/clone_repo.sh")
fi
mo_ensure_repo

case "$(uname -s)" in
    Darwin)
        exec script/dev_setup_macos "$@"
        ;;
    Linux)
        exec script/dev_setup_ubuntu "$@"
        ;;
    *)
        echo "Unrecognized OS ($(uname -s)) -- this dispatcher only knows"
        echo "macOS (Darwin) and Ubuntu (Linux). Run script/dev_setup_macos"
        echo "or script/dev_setup_ubuntu directly if one of those fits."
        exit 1
        ;;
esac
