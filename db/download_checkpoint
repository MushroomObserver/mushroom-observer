#!/bin/bash
set -euo pipefail

# Downloads the most recent db snapshot from the images server to the
# `/mushroom-observer` root directory as `checkpoint.gz`, verifies it is a
# complete dump, then calls `db/strip_checkpoint` to import it into MySQL
# as `mo_development` and strip passwords, login secrets and private gps
# data via `db/clean.sql`.
# Requires the user calling the script to have an SSH account on `images`.

backup_dir=/data/images/backup

# Prompt the user for their name
read -p "Your account name on the images server: " user_name
remote="$user_name@images.mushroomobserver.org"

# Ask the server which snapshot is newest. A date computed from the local
# clock guesses wrong: the dump lands at 05:44 UTC, so "today" is a day
# ahead of the newest file for anyone west of UTC and a day behind it for
# anyone far enough east.
latest=$(ssh "$remote" "ls -1 $backup_dir/database-[0-9]*.gz | sort | tail -1")
echo "Downloading $latest"
scp "$remote:$latest" ./checkpoint.gz

# script/backup_database.sh scp's the dump into place under its final
# name, so for the few seconds that transfer takes the file is readable
# and short. A download smaller than the finished remote file read it
# mid-transfer.
remote_size=$(ssh "$remote" "stat -c %s '$latest'")
if [ "$(wc -c < checkpoint.gz)" != "$remote_size" ]; then
  echo "checkpoint.gz is short of $latest - the dump was still being" >&2
  echo "written. Re-run this script." >&2
  exit 1
fi

# mysqldump's own last line, and the only check that covers a dump which
# died midway: that still produces an intact .gz of partial SQL.
if ! gunzip -c checkpoint.gz | tail -c 200 | grep -q "Dump completed"; then
  echo "checkpoint.gz is not a complete mysqldump." >&2
  exit 1
fi

# Strip the checkpoint
./db/strip_checkpoint
